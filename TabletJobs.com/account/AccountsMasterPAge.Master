     <!-- Wrap the section in a full-width flex container and center it -->
<div class="container">
    <div class="d-flex justify-content-center align-items-center py-2">
        <asp:PlaceHolder ID="phLoggedIn" runat="server" Visible="false">
            <div class="d-flex align-items-center">
                <span class="navbar-text text-success me-3">
                    <i class="fas fa-user-circle me-1"></i>
                    Welcome, <asp:Label ID="lblUsername" runat="server" CssClass="fw-bold" />
                </span>
                <asp:LinkButton ID="lnkLogout" runat="server"
                    CssClass="btn btn-outline-danger btn-sm"
