/* Social Media Icons Below Logo */
        .social-media-header {
            text-align: center;
            padding: 10px 0;
            background-color: #f8f9fa;
            border-bottom: 2px solid #e9ecef;
        }

        .social-icons-header {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .social-icons-header a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            color: white;
            text-decoration: none;
            transition: all 0.3s ease;
            font-size: 20px;
        }

        .social-icons-header a:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        /* Social Media Colors */
        .social-icons-header a.facebook { background-color: #1877f2; }
        .social-icons-header a.instagram { background: linear-gradient(45deg, #405de6, #5851db, #833ab4, #c13584, #e1306c, #fd1d1d); }
        .social-icons-header a.twitter { background-color: #1da1f2; }
        .social-icons-header a.youtube { background-color: #ff0000; }
        .social-icons-header a.telegram { background-color: #0088cc; }
        .social-icons-header a.whatsapp { background-color: #25d366; }
        .social-icons-header a.linkedin { background-color: #0077b5; }
         .mobile-center-img {
