 .top-bar {
            background-color: #f0f8ff; /* Light bluish for freshness */
            padding: 12px 0;
            text-align: center;
            border-bottom: 1px solid #d0d0d0;
        }

        .top-bar-text {
            font-weight: bold;
            color: #2c3e50;
        }

        .top-bar-link {
            background-color: #28a745; /* Soft green */
            color: white;
            padding: 8px 18px;
            border-radius: 20px;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            margin-left: 10px;
            display: inline-block;
            transition: background-color 0.3s ease, transform 0.2s ease;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }

        .top-bar-link:hover {
            background-color: #218838;
            transform: scale(1.05);
        }

/* Responsive tweak */
@media (max-width: 768px) {
    .top-bar-text {
        text-align: center;
        font-size: 15px;
    }

    .top-bar-link {
        display: block;
        margin: 10px auto 0 auto;
        width: fit-content;
    }
}
.text-container {
    width: 100%;
    overflow: hidden;
    position: relative;
    text-align: center; /* Centers the text inside the container */
    background-color:#1379BE;
  }
  .float-left {
    margin-left: 30px; /* Adjust the value as needed */
}

  .floating-text {
    position: relative;
    animation: floatText 40s linear infinite;
    color: white;
  }

.marquee {
    width: 100%; /* Set the width to occupy only part of the screen */
    margin: 0 auto; /* Center the marquee */
    position: relative;
    overflow: hidden; /* Hide the overflow */
    white-space: nowrap;
    display: flex;
    align-items: center; /* Vertically center text */
}
</style>
    <style>
/* Additional CSS for better user controls styling */
.navbar-text {
    margin-bottom: 0;
    font-size: 14px;
}

.btn-sm {
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
}

/* Mobile responsive adjustments */
@media (max-width: 768px) {
    .navbar .d-flex.ms-auto {
        margin-top: 10px;
        justify-content: center;
        width: 100%;
    }
    
    .navbar .d-flex.align-items-center.gap-2 {
        flex-direction: column;
        gap: 8px !important;
    }
    
    .navbar .d-flex.align-items-center.gap-2 .btn {
        width: 120px;
        text-align: center;
    }
}

/* Hover effects for buttons */
.btn-outline-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 4px rgba(0,123,255,0.3);
}

.btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 4px rgba(0,123,255,0.4);
}

.btn-outline-danger:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 4px rgba(220,53,69,0.3);
}
/* ?? STOP ADS FROM GOING BELOW FOOTER (MOBILE FIX) */
.ads-container {
    min-height: 0px;   /* Reserve mobile ad space */
    margin: 10px 0;
    clear: both;
}

@media (min-width: 769px) {
    .ads-container {
        min-height: auto;
    }
}

.ads-clear {
    height: 10px;
    clear: both;
}

/* AdSense: remove unwanted blank height */
.ads-container{
 margin: 10px 0;       /* thoda vertical space */
    padding: 0;
    text-align: center;   /* ad center align */
    line-height: normal;  /* normal line-height */
    font-size: 1rem;
}

/* Don't allow min-height from anywhere */
.ads-container ins.adsbygoogle{
 display: inline-block !important;
    width: 100% !important;       /* full-width responsive ad */
    height: auto !important;
    max-height: 250px;
}
.whatsapp-float {
    position: fixed;
    bottom: 90px;      /* adjust if needed */
    right: 20px;
    width: 48px;
    height: 48px;
    z-index: 9999;
}

.whatsapp-float img {
    width: 100%;
    height: 100%;
    cursor: pointer;
    transition: transform 0.2s ease;
}

.whatsapp-float img:hover {
    transform: scale(1.1);
}
/* Mobile Fix */
@media (max-width: 768px) {
    .ads-container {
        margin: 5px 0;
    }

    .ads-container ins.adsbygoogle {
        max-height: 150px;
    }
}

/* ================================
   FOOTER
================================ */
/* ================================
   FOOTER
================================ */

.site-footer {
    width: 100%;
    background: #102a43;
    color: #d9e2ec;
    margin: 40px 0 0 0;
    padding: 45px 0 0 0;

    /* Prevent Bootstrap/other CSS from shrinking footer */
    display: block;
    clear: both;
}


/* Main footer container */

.footer-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 25px;
    box-sizing: border-box;
}


/* Three columns */

.footer-row {
    width: 100%;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 60px;
    align-items: start;
}


/* Columns */

.footer-column {
    min-width: 0;
}


/* Company */

.footer-column h4 {
    color: #000000;
    font-size: 25px;
    font-weight: 700;
    margin: 0 0 8px 0;
}

.footer-column h5 {
    color: #000000;
    font-size: 17px;
    font-weight: 700;
    margin: 22px 0 12px 0;
}

.footer-tagline {
    color: #4fd1c5;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    margin: 0 0 8px 0;
}

.footer-owned {
    color: #9fb3c8;
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
    max-width: 350px;
}


/* Contact */

.contact-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;

    margin: 0 0 14px 0;

    color: #d9e2ec;
    font-size: 14px;
    line-height: 1.6;
}

.contact-icon {
    flex: 0 0 20px;
    font-size: 16px;
}

.contact-item a {
    color: #d9e2ec;
    text-decoration: none;
}

.contact-item a:hover {
    color: #4fd1c5;
    text-decoration: underline;
}


/* Quick links */

.footer-title {
    color: #ffffff !important;
    font-size: 18px !important;
    font-weight: 700 !important;
    margin: 0 0 18px 0 !important;
    padding-bottom: 10px;

    border-bottom: 2px solid #4fd1c5;

    display: inline-block;
}


.footer-menu {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
}

.footer-menu li {
    margin: 0 0 11px 0;
    padding: 0;
}

.footer-menu li::before {
    content: none !important;
}

.footer-menu a {
    color: #d9e2ec;
    text-decoration: none;
    font-size: 14px;
    transition: all 0.2s ease;
}

.footer-menu a::before {
    content: "›";
    color: #4fd1c5;
    font-size: 18px;
    margin-right: 8px;
}

.footer-menu a:hover {
    color: #4fd1c5;
    padding-left: 4px;
}


/* Social */

.social-description {
    color: #9fb3c8;
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 18px 0;
    max-width: 280px;
}


/* Social icons */

.footer-icons {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px !important;
    margin: 0 !important;
    padding: 0 !important;
}

.footer-icons a {
    width: 42px;
    height: 42px;

    padding: 0 !important;
    margin: 0 !important;

    background: #ffffff;

    border-radius: 50%;

    display: flex !important;
    align-items: center;
    justify-content: center;

    text-decoration: none !important;

    transition: all 0.25s ease;
}

.footer-icons a:hover {
    transform: translateY(-4px);
    box-shadow: 0 5px 12px rgba(0,0,0,0.3);
}

.footer-icons img {
    width: 23px !important;
    height: 23px !important;

    max-width: 23px !important;
    max-height: 23px !important;

    object-fit: contain;

    margin: 0 !important;
    padding: 0 !important;

    display: block;
}


/* Disclaimer */

.footer-disclaimer {
    width: 100%;
    border-top: 1px solid rgba(255,255,255,0.15);

    margin-top: 35px;
    padding: 20px 0 15px;

    color: #9fb3c8;
    font-size: 12px;
    line-height: 1.6;
}

.footer-disclaimer p {
    margin: 0 0 8px 0;
}

.footer-disclaimer strong {
    color: #ffffff;
}


/* Copyright */

.footer-copyright {
    width: 100%;

    border-top: 1px solid rgba(255,255,255,0.15);

    padding: 15px 0;

    text-align: center;

    color: #9fb3c8;

    font-size: 13px;
}

.footer-copyright strong {
    color: #ffffff;
}


/* ================================
   TABLET
================================ */

@media (max-width: 900px) {

    .footer-row {
        grid-template-columns: 1.5fr 1fr;
        gap: 35px;
    }

    .footer-column:last-child {
        grid-column: 1 / -1;
    }

}


/* ================================
   MOBILE
================================ */

@media (max-width: 600px) {

    .site-footer {
        padding-top: 30px;
    }

    .footer-container {
        padding: 0 20px;
    }

    .footer-row {
        display: flex;
        flex-direction: column;
        gap: 30px;
    }

    .footer-column {
        width: 100%;
    }

    .footer-column h4 {
        font-size: 23px;
    }

    .footer-disclaimer {
        margin-top: 30px;
    }

    .footer-copyright {
        text-align: center;
    }


.site-footer {
    text-align: center !important;
}

.footer-container {
    margin-left: auto !important;
    margin-right: auto !important;
    text-align: center !important;
}

.footer-row {
    display: flex !important;
    justify-content: center !important;
    align-items: flex-start !important;
    width: 100% !important;
}

.footer-column {
    width: 100% !important;
    max-width: 700px !important;
    text-align: center !important;
}

.footer-column h4,
.footer-column h5 {
    text-align: center !important;
}

.contact-item {
    justify-content: center !important;
    text-align: center !important;
}

.contact-item > span:last-child {
    text-align: center !important;
}

.footer-disclaimer {
    text-align: center !important;
}

.footer-disclaimer p {
    text-align: center !important;
}

.footer-copyright {
    text-align: center !important;
}
}
.site-footer {
    text-align: center !important;
}

.site-footer .footer-row {
    display: flex !important;
    justify-content: center !important;
    width: 100% !important;
}

.site-footer .footer-column {
    width: 100% !important;
    max-width: 700px !important;
    margin: 0 auto !important;
    text-align: center !important;
}

.site-footer .contact-item {
    justify-content: center !important;
}

.site-footer .footer-disclaimer,
.site-footer .footer-disclaimer p,
.site-footer .footer-copyright {
    text-align: center !important;
}
</style>
